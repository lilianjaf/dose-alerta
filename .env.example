# JWT (modulo-usuario emite e valida; os demais módulos só validam, com JWT_PUBLIC_KEY)
# Ambas em base64 DER (sem cabeçalho -----BEGIN...-----), ex.:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl pkey -in private.pem -outform DER | base64 -w0            -> JWT_PRIVATE_KEY (só modulo-usuario)
#   openssl pkey -in private.pem -pubout -outform DER | base64 -w0    -> JWT_PUBLIC_KEY (todos os módulos)
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# Twilio (modulo-mensageria)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_VOICE_NUMBER=
# URL publicamente acessível do modulo-mensageria, para os webhooks de resposta/status do Twilio
# (em dev, use um túnel como ngrok; a sandbox do Twilio não alcança localhost diretamente)
TWILIO_WEBHOOK_BASE_URL=
