DB_URL=
DB_USERNAME=
DB_PASSWORD=

# chaves em base64 DER:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl pkcs8 -topk8 -nocrypt -in private.pem -outform DER | base64 -w0 -> JWT_PRIVATE_KEY (PKCS#8)
#   openssl pkey -in private.pem -pubout -outform DER | base64 -w0  -> JWT_PUBLIC_KEY
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox do WhatsApp (Console > Messaging > Try it out > Send a WhatsApp message): funciona na hora, sem
# aprovação da Meta. Número fixo, compartilhado por todas as contas Twilio, sem o prefixo "whatsapp:".
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_VOICE_NUMBER=
# URL pública (ex: ngrok) até este módulo; configure a mesma URL + /webhooks/twilio/mensagens no Console do
# Twilio, em "WHEN A MESSAGE COMES IN" da configuração do Sandbox.
TWILIO_WEBHOOK_BASE_URL=

GEMINI_API_KEY=
# true faz o modulo-ia devolver dados fixos em vez de erro quando o Gemini falha (mesmo após o fallback entre
# modelos). Desligado por padrão — só ligue sabendo que mascara uma falha real da IA (ex: antes de gravar demo).
IA_MOCK_DE_EMERGENCIA_HABILITADO=false
