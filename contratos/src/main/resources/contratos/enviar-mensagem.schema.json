{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dosealerta/contratos/enviar-mensagem.schema.json",
  "title": "EnviarMensagemCommand",
  "description": "modulo-notificacao -> modulo-mensageria, POST /mensagens/enviar",
  "type": "object",
  "properties": {
    "telefone": {
      "type": "string",
      "pattern": "^\\+[0-9]{10,15}$"
    },
    "texto": {
      "type": "string",
      "minLength": 1
    },
    "textoBotao": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "telefone",
    "texto",
    "textoBotao"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "telefone": "+5511999999999",
      "texto": "Hora de tomar Losartana 50mg",
      "textoBotao": "CONFIRMAR"
    }
  ]
}
